{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xminds.example/schemas/product-manifest-v1.schema.json",
  "title": "Xminds Release Platform Product Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "display_name",
    "artifact_types",
    "version_scheme",
    "compatibility_keys",
    "catalog_format",
    "default_channels"
  ],
  "properties": {
    "schema_version": {
      "const": "xminds-product-manifest/v1"
    },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,62}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "artifact_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,63}$"
      }
    },
    "version_scheme": {
      "const": "semver"
    },
    "compatibility_keys": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{0,63}$"
      }
    },
    "catalog_format": {
      "const": "xminds-tuf-v1"
    },
    "default_channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "display_name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    }
  }
}

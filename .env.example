# 仅用于本地开发示例；不要在此文件存放真实密钥。
XMINDS_RELEASE_ENVIRONMENT=development
XMINDS_RELEASE_API_LISTEN=127.0.0.1:8080
XMINDS_RELEASE_PUBLIC_LISTEN=127.0.0.1:8081
XMINDS_RELEASE_DATABASE_URL=postgres://xminds_release:xminds_release@127.0.0.1:5432/xminds_release?sslmode=disable
XMINDS_RELEASE_OBJECT_STORE_URL=http://127.0.0.1:9000
XMINDS_RELEASE_OBJECT_BUCKET=xminds-release
XMINDS_RELEASE_OIDC_ISSUER=http://127.0.0.1:5556
XMINDS_RELEASE_OIDC_AUDIENCE=xminds-release-platform
XMINDS_RELEASE_LOCAL_ADMIN_ENABLED=false
XMINDS_RELEASE_WORKER_ID=release-worker-development
XMINDS_RELEASE_JOB_LEASE=30s

# 仅用于本地开发示例；不要在此文件存放真实密钥。
XMINDS_RELEASE_ENVIRONMENT=development
XMINDS_RELEASE_API_LISTEN=127.0.0.1:8080
XMINDS_RELEASE_PUBLIC_LISTEN=127.0.0.1:8081
XMINDS_RELEASE_DEFAULT_PRODUCT_ID=ngep
XMINDS_RELEASE_DEFAULT_CHANNEL=stable
XMINDS_RELEASE_DATABASE_URL=postgres://xminds_release:xminds_release@127.0.0.1:5432/xminds_release?sslmode=disable
XMINDS_RELEASE_OBJECT_STORE_URL=http://127.0.0.1:9000
XMINDS_RELEASE_OBJECT_BUCKET=xminds-release
# 对象存储凭据应通过 Secret 注入，示例值仅限本地环境。
XMINDS_RELEASE_OBJECT_STORE_ACCESS_KEY=xminds-release-local
XMINDS_RELEASE_OBJECT_STORE_SECRET_KEY=replace-with-local-secret
XMINDS_RELEASE_OBJECT_STORE_REGION=
XMINDS_RELEASE_OBJECT_STORE_SESSION_TOKEN=
# 私有分发端点企业 CA 目录；tls_ca_ref 只能引用目录下的单一文件名。
XMINDS_RELEASE_ENDPOINT_CA_DIRECTORY=/run/secrets/xminds-release/endpoint-cas
XMINDS_RELEASE_OIDC_ISSUER=http://127.0.0.1:5556
XMINDS_RELEASE_OIDC_AUDIENCE=xminds-release-platform
XMINDS_RELEASE_LOCAL_ADMIN_ENABLED=false
# API 与 Worker 共享的 IAM Secret 根必须是绝对路径；文件名对应 secret://iam/<name>，目录及文件权限不得开放给 group/other。
# 该变量名为了兼容现有部署保留 MFA 命名，实际同时承载 MFA、OIDC/SCIM 配置、Bearer 和企业 CA。
XMINDS_RELEASE_IAM_MFA_SECRET_DIRECTORY=/run/secrets/xminds-release/iam
# 目录上游请求总超时范围 1s..30s；总页数 1..10000；用户、组织、成员及层级关系总数 1..100000。
XMINDS_RELEASE_IAM_DIRECTORY_REQUEST_TIMEOUT=10s
XMINDS_RELEASE_IAM_DIRECTORY_MAXIMUM_PAGES=10000
XMINDS_RELEASE_IAM_DIRECTORY_MAXIMUM_OBJECTS=100000
# 冲突列表游标使用独立 32 字节 AES-256-GCM 密钥；不得复用 Bearer、CA、MFA 或其他业务密钥。
# 轮换时原子替换 Secret 并重启 API；旧游标立即 fail closed，客户端从首页重新分页。
XMINDS_RELEASE_IAM_DIRECTORY_CONFLICT_CURSOR_KEY_REFERENCE=secret://iam/directory-conflict-cursor-key
XMINDS_RELEASE_IAM_DIRECTORY_CONFLICT_CURSOR_TTL=15m
# 仅 development/test 可显式开启 loopback（变量名为兼容保留，HTTP/HTTPS 均受该出站策略约束）。
XMINDS_RELEASE_IAM_DIRECTORY_ALLOW_LOOPBACK_HTTP=true
# 企业私网地址默认拒绝；只有在网络边界已审核时才显式开启，并仍强制 TLS、DNS 地址固定与私有 CA 验证。
XMINDS_RELEASE_IAM_DIRECTORY_ALLOW_PRIVATE_NETWORKS=false
# 生产/测试/预发必须指向非可写 SHA-1/SHA-256 摘要语料库。
XMINDS_RELEASE_IAM_BREACH_CORPUS=
# 仓库内最小语料库仅允许在显式 development 环境中单独开启；不得与外部语料库同时配置。
XMINDS_RELEASE_IAM_USE_DEVELOPMENT_BREACH_CORPUS=true
# 失败次数:锁定时长，阶段必须严格递增并满足运行时安全上下界。
XMINDS_RELEASE_IAM_LOCKOUT_STAGES=5:5m,8:30m,10:24h
# 高风险 evidence 只存储 SHA-256 摘要；以下参数均由运行时安全边界约束。
XMINDS_RELEASE_IAM_REAUTH_CHALLENGE_TTL=5m
XMINDS_RELEASE_IAM_REAUTH_EVIDENCE_TTL=2m
XMINDS_RELEASE_IAM_REAUTH_OIDC_MAXIMUM_AGE=5m
XMINDS_RELEASE_IAM_REAUTH_ALLOWED_CLOCK_SKEW=30s
XMINDS_RELEASE_IAM_REAUTH_TERMINAL_RETENTION=24h
XMINDS_RELEASE_IAM_REAUTH_CLEANUP_BATCH_SIZE=128
XMINDS_RELEASE_WORKER_ID=release-worker-development
XMINDS_RELEASE_JOB_LEASE=30s
XMINDS_RELEASE_WORKER_POLL_INTERVAL=1s
# 以下路径必须是绝对路径；在线目录不得包含 root 私钥。
XMINDS_RELEASE_SIGNING_KEY_DIRECTORY=/run/secrets/xminds-release/catalog-keys
XMINDS_RELEASE_SIGNING_MASTER_KEY_PATH=/run/secrets/xminds-release/catalog-master.key
XMINDS_RELEASE_CATALOG_ROOT_PATH=/etc/xminds-release/catalog/root.json
XMINDS_RELEASE_CATALOG_TARGETS_KEY_REFS=targets
XMINDS_RELEASE_CATALOG_SNAPSHOT_KEY_REFS=snapshot
XMINDS_RELEASE_CATALOG_TIMESTAMP_KEY_REFS=timestamp
XMINDS_RELEASE_CATALOG_REVOCATION_KEY_REFS=revocation
# SCM Provider 凭据使用独立 AES-256-GCM 主密钥；当前 key ID 与历史解密 key 必须由 Secret 注入。
XMINDS_RELEASE_SCM_CREDENTIAL_CURRENT_KEY_ID=scm-credentials-2026-08
XMINDS_RELEASE_SCM_CREDENTIAL_KEY_DIRECTORY=/run/secrets/xminds-release/scm-credential-keys
XMINDS_RELEASE_AUDIT_EXPORT_TEMP_DIR=/var/tmp/xminds-release-audit
